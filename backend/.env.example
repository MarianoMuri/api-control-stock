# Servidor
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=control_stock
DB_USER=postgres
DB_PASSWORD=cambiar_esta_password

# Clave para firmar los JWT (obligatoria). Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Usuario administrador que se crea al iniciar si no existe (opcional)
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin123
