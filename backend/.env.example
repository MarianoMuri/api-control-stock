# Servidor
PORT=3000

# Base de datos PostgreSQL
# Opción 1 (producción, p. ej. Neon): una sola URL. Usa SSL salvo DB_SSL=false.
# DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require
# Opción 2 (local): variables separadas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=control_stock
DB_USER=postgres
DB_PASSWORD=cambiar_esta_password

# Clave para firmar los JWT (obligatoria). Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Usuario administrador que se crea al iniciar si no existe (opcional)
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin123
