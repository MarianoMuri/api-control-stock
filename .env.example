# Variables para docker compose. Copiá este archivo a .env antes de levantar los contenedores.
POSTGRES_PASSWORD=cambiar_esta_password

# Clave para firmar los JWT (obligatoria). Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin123
